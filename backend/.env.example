# Copy to backend/.env and fill in (backend/.env is gitignored)

# Resend — password reset + login notices (local + Railway)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=QUANT <onboarding@resend.dev>

# Must match how you open the UI locally:
# Docker frontend → http://localhost:8080
# npm start (CRA) → http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Promoted to admin on backend start (register this email first)
ADMIN_PROMOTE_EMAIL=you@example.com

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
