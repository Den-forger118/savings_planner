# Copy to backend/.env and fill in (backend/.env is gitignored)

# Resend — password reset + login notices + goal reminders (local + Railway)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=QUANT <onboarding@resend.dev>

# Optional: protect POST /api/internal/reminders/run for an external cron
# Header: x-reminder-secret: <same value>
# REMINDER_CRON_SECRET=change-me

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# AI Coach — pick one provider
# A) Hugging Face (needs Inference Providers credits; free monthly allowance can run out)
# AI_PROVIDER=huggingface
# HF_TOKEN=hf_...
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# B) Groq free tier (recommended if HF credits are empty) — https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
#
# C) OpenAI later: AI_PROVIDER=openai + OPENAI_API_KEY + OPENAI_MODEL=gpt-4o-mini

# Paystack Option 1 — goal deposits (test keys first)
# Dashboard → Settings → API Keys & Webhooks
# Webhook URL: https://YOUR_RAILWAY_HOST/api/payments/webhook
# Events: charge.success
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_CURRENCY=GHS
# Ledger currencies allowed to open Paystack (non-GHS amounts are FX-converted for the charge)
# PAYSTACK_LEDGER_CURRENCIES=GHS,USD,EUR,GBP,NGN
# Option 2 DVA — optional preferred bank/provider slug (e.g. test-bank, wema-bank)
# PAYSTACK_DVA_BANK=test-bank
# Webhook events: charge.success, dedicatedaccount.assign,
#   transfer.success, transfer.failed, transfer.reversed
# Transfers require Paystack Transfer enabled + balance (disable OTP for API in dashboard if needed)

# Must match how you open the UI (no trailing slash).
# Local Docker → http://localhost:8080 | npm start → http://localhost:3000
# Railway: use your live Vercel URL (reset-email links + CORS).
FRONTEND_URL=http://localhost:8080
# Optional: ALLOW_VERCEL_PREVIEWS=false to block https://*.vercel.app CORS

# Promoted to admin on backend start (register this email first)
ADMIN_PROMOTE_EMAIL=you@example.com

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
